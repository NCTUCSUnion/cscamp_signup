  "activity": {
    "intro": "本次營隊除了精彩的程式課程之外，也安排了兩項特別的活動，讓學員親身走進台灣資訊科技的第一線，並與系上教授和學長近距離交流。",
    "questionFormUrl": "https://docs.google.com/forms/d/e/1FAIpQLSeUAmbbh5bQr60HUJsuxJrNZX4CcTM6GtZgQdvWR1_KQDj6bw/viewform?usp=dialog",
    "nchcVisit": {
      "title": "新竹國網中心參訪",
      "subtitle": "走進台灣最強的算力核心",
      "description": "國家高速網路與計算中心（NCHC）負責建置與維運台灣最重要的高效能運算（HPC）基礎設施，旗下頂級超級電腦「晶創 26」算力高達 81.55 PFlops，名列全球 TOP500 第 29 名，是目前台灣速度最快、運算密度最高的 AI 算力主力，長年支援台灣的氣候模擬、生醫研究與大型 AI 模型訓練（包含本土 TAIDE 大型語言模型）。本次活動將安排學員實地參訪位於新竹的國網中心，親眼見證「算力即國力」並非口號，了解超級電腦如何支撐台灣的科研發展。",
      "highlights": [
        "親眼見證「晶創 26」—— 全球第 29 名、台灣最快的 AI 算力主力",
        "認識高效能運算（HPC）與 AI 雲端服務的實際應用",
        "由國網中心同仁親自導覽，第一手了解國家級資通訊建設"
      ],
      "image": "/images/activity/nchc.webp",
      "website": "https://www.nchc.org.tw/"
    },
    "professorTalk": {
      "title": "專家座談會",
      "subtitle": "與系上教授、學長面對面",
      "description": "我們邀請了系上多位於不同領域具有代表性的教授，以及一位走過相同路徑的學長，與學員分享他們的研究領域、求學與職涯歷程，並開放現場提問。實際討論主題將於事前問題蒐集後彙整決定，希望幫助學員了解資工系的多元面貌，並對未來的學習方向有更具體的想像。",
      "preQuestionNote": "為了讓座談會更聚焦於大家關心的議題，我們會在營期前透過表單事先蒐集學員想詢問講者的問題；表單連結將於報到後或營隊資訊中提供。"
    },
    "professors": [
      {
        "id": "chang-lipin",
        "name": "張立平",
        "position": "資訊工程學系 系主任／教授",
        "photo": "/images/professors/張立平.webp",
        "homepage": "https://sites.google.com/view/lpchang",
        "introFile": "/contents/professors/張立平.txt",
        "fields": ["嵌入式系統", "AIoT", "儲存與記憶體系統", "作業系統"],
